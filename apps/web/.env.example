# Absolute base URL of the deployed site, used for Open Graph and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the build reads the catalogue from. Leave it unset and `npm run build`
# starts @discopod/api itself for the duration of the build; set it to build
# against an API you already have running. `next dev` falls back to :3001,
# which is where `npm run dev --workspace @discopod/api` listens.
# CATALOG_API_URL=http://127.0.0.1:3001/api
