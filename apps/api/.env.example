# Port the API listens on.
PORT=3001

# Origin allowed to call the API from the browser.
WEB_ORIGIN=http://localhost:3000

# Where saved words and the published catalogue live.
#
# Leave it unset and the API runs entirely in memory: the catalogue is read
# from the seed JSON, and saved words are lost on restart. That is the mode the
# web build and CI use, and it is fine for a laptop.
#
# Set it and the API migrates the schema and publishes the seed catalogue on
# boot. It is never a fallback: if the URL is set and the database cannot be
# reached, the boot fails rather than quietly serving from memory. TLS is the
# URL's business — append `?sslmode=require` for a managed Postgres.
#
# DATABASE_URL=postgres://discopod:discopod@127.0.0.1:5432/discopod
